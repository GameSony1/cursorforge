{
  "name": "cursor-customizer-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev": "concurrently -k -n server,desktop -c blue,magenta \"npm:dev:server\" \"npm:dev:desktop\"",
    "build": "npm run build -w apps/server && npm run build -w apps/desktop"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
